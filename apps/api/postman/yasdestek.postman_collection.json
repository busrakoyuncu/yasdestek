{
  "info": {
    "name": "Yasdestek API",
    "description": "Local api on {{baseUrl}}. Postman keeps the session cookie after login, so the other requests work without extra setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "moduleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Sets the sid cookie. 401 INVALID_CREDENTIALS or ACCOUNT_INACTIVE, 429 after 10 attempts per minute."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Current user from the session cookie. 401 without a valid session."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"a-new-password\"\n}"
            },
            "description": "204 on success and ends every other session. 400 WRONG_PASSWORD. Note: the seed does not reset the admin password afterwards."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "204, clears the cookie."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Admin and psychologist only. Psychologists see and manage their own participants.",
      "item": [
        {
          "name": "Create psychologist (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"PSYCHOLOGIST\",\n  \"username\": \"dr.ayse\"\n}"
            },
            "description": "201 with the account and its temporary password, shown once. 409 USERNAME_TAKEN."
          }
        },
        {
          "name": "Create participant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\",\n  \"username\": \"elif\",\n  \"psychologistId\": \"{{userId}}\"\n}"
            },
            "description": "As a psychologist, psychologistId is ignored and set to yourself. As admin it is required: 400 PSYCHOLOGIST_REQUIRED."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users",
            "description": "Admin: every non-admin account. Psychologist: own participants."
          }
        },
        {
          "name": "Activate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/activate",
            "description": "204. 404 when the account is not yours."
          }
        },
        {
          "name": "Deactivate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/deactivate",
            "description": "204 and ends the account's sessions immediately."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/reset-password",
            "description": "201 with a new temporary password. The owner must change it at next login."
          }
        }
      ]
    },
    {
      "name": "Groups",
      "description": "Psychologists organise their own groups. Admins read all groups and may delete one.",
      "item": [
        {
          "name": "Create (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salı grubu\"\n}"
            },
            "description": "201 with the group and its members."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/groups",
            "description": "Own groups for a psychologist, every group for an admin. Members included."
          }
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "404 when the group is not yours."
          }
        },
        {
          "name": "Rename (psychologist)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salı akşam grubu\"\n}"
            },
            "description": "204."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "204. Members keep their accounts and content, module assignments are dropped."
          }
        },
        {
          "name": "Add member (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups/{{groupId}}/members",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "description": "204. Only your own participants; a participant in another of your groups moves."
          }
        },
        {
          "name": "Remove member (psychologist)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}/members/{{userId}}",
            "description": "204. 404 when not a member of your group."
          }
        }
      ]
    },
    {
      "name": "Modules",
      "description": "Admins create global modules, psychologists private ones. Participants see what is assigned to their group.",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/modules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Modül 7 - Örnek\",\n  \"description\": \"Bu modülde ...\",\n  \"rules\": \"Kurallar ...\",\n  \"questions\": [\n    \"Soru 1\",\n    \"Soru 2\"\n  ]\n}"
            },
            "description": "Admin or psychologist. rules and at least one question are required. order defaults to the end."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules",
            "description": "Visible modules in order. Participants: their group's assigned modules."
          }
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "description": "404 when not visible to you."
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Yeni başlık\"\n}"
            },
            "description": "Partial. Admin: global modules. Psychologist: own. 204."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "description": "204. 403 BASE_MODULE for base modules, 409 MODULE_IN_USE once responses exist."
          }
        },
        {
          "name": "Assign to group (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups/{{groupId}}/modules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moduleId\": \"{{moduleId}}\"\n}"
            },
            "description": "204. Own group, visible module. Assigning twice is harmless."
          }
        },
        {
          "name": "Unassign from group (psychologist)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}/modules/{{moduleId}}",
            "description": "204. 404 when it was not assigned."
          }
        }
      ]
    }
  ]
}
