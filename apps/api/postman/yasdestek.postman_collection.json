{
  "info": {
    "name": "Yasdestek API",
    "description": "Local api on {{baseUrl}}. Postman keeps the session cookie after login, so the other requests work without extra setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "moduleId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "responseId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Sets the sid cookie. 401 INVALID_CREDENTIALS or ACCOUNT_INACTIVE, 429 after 10 attempts per minute."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Current user from the session cookie. 401 without a valid session."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"a-new-password\"\n}"
            },
            "description": "204 on success and ends every other session. 400 WRONG_PASSWORD. Note: the seed does not reset the admin password afterwards."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "204, clears the cookie."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Admin and psychologist only. Psychologists see and manage their own participants.",
      "item": [
        {
          "name": "Create psychologist (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"PSYCHOLOGIST\",\n  \"username\": \"dr.ayse\"\n}"
            },
            "description": "201 with the account and its temporary password, shown once. 409 USERNAME_TAKEN."
          }
        },
        {
          "name": "Create participant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\",\n  \"username\": \"elif\",\n  \"psychologistId\": \"{{userId}}\"\n}"
            },
            "description": "As a psychologist, psychologistId is ignored and set to yourself. As admin it is required: 400 PSYCHOLOGIST_REQUIRED."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users",
            "description": "Admin: every non-admin account. Psychologist: own participants."
          }
        },
        {
          "name": "Activate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/activate",
            "description": "204. 404 when the account is not yours."
          }
        },
        {
          "name": "Deactivate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/deactivate",
            "description": "204 and ends the account's sessions immediately."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/{{userId}}/reset-password",
            "description": "201 with a new temporary password. The owner must change it at next login."
          }
        }
      ]
    },
    {
      "name": "Groups",
      "description": "Psychologists organise their own groups. Admins read all groups and may delete one.",
      "item": [
        {
          "name": "Create (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salı grubu\"\n}"
            },
            "description": "201 with the group and its members."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/groups",
            "description": "Own groups for a psychologist, every group for an admin. Members included."
          }
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "404 when the group is not yours."
          }
        },
        {
          "name": "Rename (psychologist)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salı akşam grubu\"\n}"
            },
            "description": "204."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "204. Members keep their accounts and content, module assignments are dropped."
          }
        },
        {
          "name": "Add member (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups/{{groupId}}/members",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "description": "204. Only your own participants; a participant in another of your groups moves."
          }
        },
        {
          "name": "Remove member (psychologist)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}/members/{{userId}}",
            "description": "204. 404 when not a member of your group."
          }
        }
      ]
    },
    {
      "name": "Modules",
      "description": "Admins create global modules, psychologists private ones. Participants see what is assigned to their group.",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/modules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Modül 7 - Örnek\",\n  \"description\": \"Bu modülde ...\",\n  \"rules\": \"Kurallar ...\",\n  \"questions\": [\n    \"Soru 1\",\n    \"Soru 2\"\n  ]\n}"
            },
            "description": "Admin or psychologist. rules and at least one question are required. order defaults to the end."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules",
            "description": "Visible modules in order. Participants: their group's assigned modules."
          }
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "description": "404 when not visible to you."
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Yeni başlık\"\n}"
            },
            "description": "Partial. Admin: global modules. Psychologist: own. 204."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "description": "204. 403 BASE_MODULE for base modules, 409 MODULE_IN_USE once responses exist."
          }
        },
        {
          "name": "Assign to group (psychologist)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/groups/{{groupId}}/modules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moduleId\": \"{{moduleId}}\"\n}"
            },
            "description": "204. Own group, visible module. Assigning twice is harmless."
          }
        },
        {
          "name": "Unassign from group (psychologist)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/groups/{{groupId}}/modules/{{moduleId}}",
            "description": "204. 404 when it was not assigned."
          }
        }
      ]
    },
    {
      "name": "Pages",
      "description": "Editable platform pages. Seeded: general-rules.",
      "item": [
        {
          "name": "Get general rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pages/general-rules",
            "description": "Any role."
          }
        },
        {
          "name": "Update general rules (admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/pages/general-rules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Genel Kurallar\\n\\n- ...\"\n}"
            },
            "description": "204. 404 for a slug that was not seeded."
          }
        }
      ]
    },
    {
      "name": "Responses",
      "description": "Participants only. One response per module, created on the first save.",
      "item": [
        {
          "name": "Get my response",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/{{moduleId}}/response",
            "description": "404 until the first save."
          }
        },
        {
          "name": "Save my response",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/modules/{{moduleId}}/response",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Haberi annemden aldım...\",\n  \"published\": false\n}"
            },
            "description": "Creates or updates. Both fields optional: text defaults to empty, published to false. 404 when the module is not assigned to your group."
          }
        }
      ]
    },
    {
      "name": "Files",
      "description": "Media attached to a response. Images up to 10MB (jpeg/png/webp/heic), audio up to 50MB (webm/mp4/aac).",
      "item": [
        {
          "name": "Upload (participant)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/files",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "moduleId",
                  "value": "{{moduleId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "multipart/form-data. Creates your draft response for the module if you have none. 400 UNSUPPORTED_FILE_TYPE / FILE_TOO_LARGE / FILE_REQUIRED, 404 when the module is not assigned to your group."
          }
        },
        {
          "name": "Download",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/files/{{fileId}}",
            "description": "Uploader, their psychologist, admin, or group mates once published. Streams the bytes."
          }
        },
        {
          "name": "Download range",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/files/{{fileId}}",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-1023"
              }
            ],
            "description": "206 with Content-Range. 416 when the start is past the end."
          }
        },
        {
          "name": "Delete (uploader)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/files/{{fileId}}",
            "description": "204. 404 for files you did not upload."
          }
        }
      ]
    },
    {
      "name": "Forum",
      "description": "A group's published responses for a module, with comments. Members comment; the group's psychologist and admins read and moderate.",
      "item": [
        {
          "name": "Read forum",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/groups/{{groupId}}/forum/{{moduleId}}",
            "description": "Members of the group, its psychologist, admins. 404 when the module is not assigned to the group or the group is not yours. Removed comments have text and author null."
          }
        },
        {
          "name": "Comment (participant)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/responses/{{responseId}}/comments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Yanındayım.\"\n}"
            },
            "description": "201. Only on published responses in your own group."
          }
        },
        {
          "name": "Remove comment (psychologist or admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/comments/{{commentId}}",
            "description": "204. Soft delete: the forum shows a placeholder. 404 when not in your groups or already removed."
          }
        }
      ]
    }
  ]
}
