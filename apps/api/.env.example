# Copy to .env and adjust. Never commit .env.

# Postgres connection used by Prisma. Matches docker-compose.yml.
DATABASE_URL="postgresql://yasdestek:yasdestek-dev@localhost:5432/yasdestek"
# E2E tests use a sibling database with a _test suffix, created and reset automatically.

# Port the api listens on (defaults to 3000 when unset)
PORT=3000

# First admin account, created by `prisma db seed`. Forced to change the password at first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# S3-compatible object storage (Garage in docker-compose.yml). Never exposed publicly.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=yasdestek
S3_SECRET_KEY=yasdestek-dev-secret
S3_BUCKET=media
